      "checkConstraints": {
        "tasks_context_shape": {
          "name": "tasks_context_shape",
          "value": "(\n        (\"tasks\".\"context\" = 'personal'\n          AND \"tasks\".\"assignee_id\" IS NOT NULL\n          AND \"tasks\".\"assignee_id\" = \"tasks\".\"created_by\"\n          AND \"tasks\".\"assignment_id\" IS NULL\n          AND \"tasks\".\"team_id\" IS NULL)\n        OR\n        (\"tasks\".\"context\" = 'assignment'\n          AND \"tasks\".\"assignee_id\" IS NOT NULL\n          AND \"tasks\".\"assignment_id\" IS NOT NULL\n          AND \"tasks\".\"team_id\" IS NULL)\n        OR\n        (\"tasks\".\"context\" = 'team'\n          AND \"tasks\".\"team_id\" IS NOT NULL\n          AND \"tasks\".\"assignment_id\" IS NULL)\n      )"
        },
        "tasks_done_has_completed_at": {
          "name": "tasks_done_has_completed_at",
          "value": "(\"tasks\".\"status\" = 'done') = (\"tasks\".\"completed_at\" IS NOT NULL)"
        },
        "tasks_category_other_label": {
          "name": "tasks_category_other_label",
          "value": "(\"tasks\".\"category\" = 'other') = (\"tasks\".\"category_other\" IS NOT NULL)"
        },
        "tasks_deleted_pair": {
          "name": "tasks_deleted_pair",
          "value": "(\"tasks\".\"deleted_at\" IS NULL) = (\"tasks\".\"deleted_reason\" IS NULL)"
        },
        "tasks_started_before_completed": {
          "name": "tasks_started_before_completed",
          "value": "\"tasks\".\"started_at\" IS NULL OR \"tasks\".\"completed_at\" IS NULL OR \"tasks\".\"started_at\" <= \"tasks\".\"completed_at\""
        },
        "tasks_reschedule_count_not_negative": {
          "name": "tasks_reschedule_count_not_negative",
          "value": "\"tasks\".\"reschedule_count\" >= 0"
        },
        "tasks_estimate_in_range": {
          "name": "tasks_estimate_in_range",
          "value": "\"tasks\".\"estimate_minutes\" IS NULL OR \"tasks\".\"estimate_minutes\" BETWEEN 1 AND 6000"
        },
        "tasks_started_after_created": {
          "name": "tasks_started_after_created",
          "value": "\"tasks\".\"started_at\" IS NULL OR \"tasks\".\"started_at\" >= \"tasks\".\"created_at\""
        },
        "tasks_completed_after_created": {
          "name": "tasks_completed_after_created",
          "value": "\"tasks\".\"completed_at\" IS NULL OR \"tasks\".\"completed_at\" >= \"tasks\".\"created_at\""
        },
        "tasks_estimate_has_source": {
          "name": "tasks_estimate_has_source",
          "value": "(\"tasks\".\"estimate_minutes\" IS NULL) = (\"tasks\".\"estimate_source\" IS NULL)"
        },
        "tasks_resubmission_only_assignment": {
          "name": "tasks_resubmission_only_assignment",
          "value": "\"tasks\".\"resubmission_until\" IS NULL OR \"tasks\".\"context\" = 'assignment'"
        },
        "tasks_deadline_has_original": {
          "name": "tasks_deadline_has_original",
          "value": "\"tasks\".\"deadline\" IS NULL OR \"tasks\".\"original_deadline\" IS NOT NULL"
        },
        "tasks_title_not_blank": {
          "name": "tasks_title_not_blank",
          "value": "length(btrim(\"tasks\".\"title\")) > 0"
        },
        "tasks_category_other_not_blank": {
          "name": "tasks_category_other_not_blank",
          "value": "\"tasks\".\"category_other\" IS NULL OR length(btrim(\"tasks\".\"category_other\")) > 0"
        },
        "tasks_personal_delete_reason": {
          "name": "tasks_personal_delete_reason",
          "value": "\"tasks\".\"context\" <> 'personal' OR \"tasks\".\"deleted_reason\" IS NULL OR \"tasks\".\"deleted_reason\" = 'user_deleted'"
        },
        "tasks_source_matches_suggestion": {
          "name": "tasks_source_matches_suggestion",
          "value": "(\"tasks\".\"source\" = 'ai_breakdown') = (\"tasks\".\"ai_suggestion_id\" IS NOT NULL)"
        },
        "tasks_not_its_own_parent": {
          "name": "tasks_not_its_own_parent",
          "value": "\"tasks\".\"parent_task_id\" IS NULL OR \"tasks\".\"parent_task_id\" <> \"tasks\".\"id\""
        }
