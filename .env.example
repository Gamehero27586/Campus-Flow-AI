# Copy this file to .env.local and fill in the values. Never commit .env.local.
# Never put a secret in a variable that starts with NEXT_PUBLIC_.

# Neon: use the POOLED connection string here (host contains "-pooler").
# Local fallback: postgres://postgres:<password>@localhost:5432/campus_flow
DATABASE_URL=

# Optional: Neon's DIRECT (non-pooled) connection string. drizzle-kit uses it for migrations when set.
# DATABASE_URL_UNPOOLED=

# Better Auth. Generate the secret with Node's cryptographic random generator:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# (Do not use PowerShell's Get-Random: it is not suitable for secrets.) It must be at least 32 characters. BETTER_AUTH_URL is the address of the app (the tunnel address for the friends test).
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google sign-in: from Google Cloud Console (APIs & Services > OAuth consent screen / Clients).
# Redirect URI to register: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Ollama stays on 127.0.0.1.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
