digraph ER {
graph [rankdir=LR, fontname="DejaVu Sans", fontsize=18, nodesep=0.6, ranksep=1.2, labelloc=t, label=<<B>CampusFlow AI: entity relationship diagram (v0.5)</B><BR/><FONT POINT-SIZE="11">PK primary key, FK foreign key, UK unique. Bar = one, crow's foot = many, circle = optional. Links to users are listed in the note instead of drawn.</FONT>>];
node [shape=plaintext, fontname="DejaVu Sans", fontsize=11];
edge [fontname="DejaVu Sans", fontsize=10, color="#444444", dir=both];
subgraph cluster_0 { label=<<B>Identity and access</B>>; style="rounded,filled"; fillcolor="#eef2f9"; color="#bbbbbb"; fontsize=15;
"roles" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#3b5ba5"><FONT COLOR="white"><B>roles</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#8b1a1a" POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT" PORT="p0">id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="9">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#8b1a1a" POINT-SIZE="9">UK</FONT></TD><TD ALIGN="LEFT" PORT="p1">key</TD><TD ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="9">admin | faculty | student</FONT></TD></TR></TABLE>>];
"permissions" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#3b5ba5"><FONT COLOR="white"><B>permissions</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#8b1a1a" POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT" PORT="p0">id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="9">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#8b1a1a" POINT-SIZE="9">UK</FONT></TD><TD ALIGN="LEFT" PORT="p1">key</TD><TD ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="9">e.g. class.create</FONT></TD></TR></TABLE>>];
"role_permissions" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#3b5ba5"><FONT COLOR="white"><B>role_permissions</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#8b1a1a" POINT-SIZE="9">PK FK</FONT></TD><TD ALIGN="LEFT" PORT="p0">role_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="9">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#8b1a1a" POINT-SIZE="9">PK FK</FONT></TD><TD ALIGN="LEFT" PORT="p1">permission_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="9">uuid</FONT></TD></TR></TABLE>>];
"users" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#3b5ba5"><FONT COLOR="white"><B>users</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#8b1a1a" POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT" PORT="p0">id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="9">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#8b1a1a" POINT-SIZE="9">UK</FONT></TD><TD ALIGN="LEFT" PORT="p1">email</TD><TD ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="9">text</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#8b1a1a" POINT-SIZE="9">UK</FONT></TD><TD ALIGN="LEFT" PORT="p2">username</TD><TD ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="9">text, null until welcome</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#8b1a1a" POINT-SIZE="9"> </FONT></TD><TD ALIGN="LEFT" PORT="p3">email_verified</TD><TD ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="9">boolean</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#8b1a1a" POINT-SIZE="9"> </FONT></TD><TD ALIGN="LEFT" PORT="p4">status</TD><TD ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="9">pending | active | rejected | deactivated</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#8b1a1a" POINT-SIZE="9"> </FONT></TD><TD ALIGN="LEFT" PORT="p5">requested_role</TD><TD ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="9">student | faculty (hint)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#8b1a1a" POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT" PORT="p6">role_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="9">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#8b1a1a" POINT-SIZE="9"> </FONT></TD><TD ALIGN="LEFT" PORT="p7">timezone</TD><TD ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="9">text</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#8b1a1a" POINT-SIZE="9"> </FONT></TD><TD ALIGN="LEFT" PORT="p8">is_seed</TD><TD ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="9">boolean</FONT></TD></TR></TABLE>>];
