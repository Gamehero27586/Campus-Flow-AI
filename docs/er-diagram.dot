"team_members" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#1f7a87"><FONT COLOR="white"><B>team_members</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#8b1a1a" POINT-SIZE="9">PK FK</FONT></TD><TD ALIGN="LEFT" PORT="p0">team_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="9">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#8b1a1a" POINT-SIZE="9">PK FK</FONT></TD><TD ALIGN="LEFT" PORT="p1">user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="9">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#8b1a1a" POINT-SIZE="9"> </FONT></TD><TD ALIGN="LEFT" PORT="p2">role</TD><TD ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="9">creator | member</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#8b1a1a" POINT-SIZE="9"> </FONT></TD><TD ALIGN="LEFT" PORT="p3">status</TD><TD ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="9">invited | active | declined | removed | left</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#8b1a1a" POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT" PORT="p4">invited_by</TD><TD ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="9">uuid</FONT></TD></TR></TABLE>>];
}
subgraph cluster_6 { label=<<B>Files</B>>; style="rounded,filled"; fillcolor="#eff1f3"; color="#bbbbbb"; fontsize=15;
"files" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#5f6b76"><FONT COLOR="white"><B>files</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#8b1a1a" POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT" PORT="p0">id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="9">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#8b1a1a" POINT-SIZE="9"> </FONT></TD><TD ALIGN="LEFT" PORT="p1">storage_key</TD><TD ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="9">text</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#8b1a1a" POINT-SIZE="9"> </FONT></TD><TD ALIGN="LEFT" PORT="p2">mime_type</TD><TD ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="9">pdf | jpeg | png</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#8b1a1a" POINT-SIZE="9"> </FONT></TD><TD ALIGN="LEFT" PORT="p3">size_bytes</TD><TD ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="9">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#8b1a1a" POINT-SIZE="9"> </FONT></TD><TD ALIGN="LEFT" PORT="p4">purpose</TD><TD ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="9">assignment_attachment | submission</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#8b1a1a" POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT" PORT="p5">assignment_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="9">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#8b1a1a" POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT" PORT="p6">submission_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="9">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#8b1a1a" POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT" PORT="p7">uploaded_by</TD><TD ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="9">uuid</FONT></TD></TR></TABLE>>];
}
subgraph cluster_7 { label=<<B>AI</B>>; style="rounded,filled"; fillcolor="#f8f2dc"; color="#bbbbbb"; fontsize=15;
"ai_suggestions" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#8a6d00"><FONT COLOR="white"><B>ai_suggestions</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#8b1a1a" POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT" PORT="p0">id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="9">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#8b1a1a" POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT" PORT="p1">user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="9">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#8b1a1a" POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT" PORT="p2">task_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="9">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#8b1a1a" POINT-SIZE="9"> </FONT></TD><TD ALIGN="LEFT" PORT="p3">kind</TD><TD ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="9">breakdown | summary</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#8b1a1a" POINT-SIZE="9"> </FONT></TD><TD ALIGN="LEFT" PORT="p4">timeframe</TD><TD ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="9">week | month</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#8b1a1a" POINT-SIZE="9"> </FONT></TD><TD ALIGN="LEFT" PORT="p5">timeframe_start</TD><TD ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="9">date</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#8b1a1a" POINT-SIZE="9"> </FONT></TD><TD ALIGN="LEFT" PORT="p6">outcome</TD><TD ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="9">enum</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#8b1a1a" POINT-SIZE="9"> </FONT></TD><TD ALIGN="LEFT" PORT="p7">rating</TD><TD ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="9">smallint</FONT></TD></TR></TABLE>>];
}
